	//bags,crates,etc in tonne
  MAIL: 400;
  GOOD: 200;

  // m3/tonne * 100
  ACET:95;
  ACID:95;
  CHLO:71;
  BEER:99;
  FORM:82; 
  HYAC:87;
  N7__:123;
  O2__:88;
  PHAC:53;
  SUAC:54;
  NHNO:59;
  MILK:97;
  C2H4:127;
  PETR:127;
  NAPH:127;
  OIL_:118;
  LYE_:66;
  UREA:77;
  RUBR:105;
  LATX:105;
  C3H6:127;
  PLAS:95;
  

	100;
}