	0: spriteset_pax_24twilight_flip_8;
    1: spriteset_pax_24twilight_flip_7;
    2: spriteset_pax_24twilight_flip_7;
    3: spriteset_pax_24twilight_flip_6;
	spriteset_pax_24twilight_flip_5;
