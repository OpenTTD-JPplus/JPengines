//autoform forward

switch(FEAT_TRAINS, SELF, switch_pax_24twilight_forward_autoform, position_in_vehid_chain) {
	0: spriteset_pax_24twilight_1;
	1: spriteset_pax_24twilight_2;
	2: spriteset_pax_24twilight_3;
	3: spriteset_pax_24twilight_4;
	spriteset_pax_24twilight_5;
	}

	
switch(FEAT_TRAINS, SELF, switch_pax_24twilight_lounge_end, position_in_vehid_chain_from_end) {
	0: spriteset_pax_24twilight_8;
    1: spriteset_pax_24twilight_7;
    2: spriteset_pax_24twilight_7;
    3: spriteset_pax_24twilight_6;
	switch_pax_24twilight_forward_autoform;
	}
	
switch(FEAT_TRAINS, SELF, switch_pax_24twilight_gen_end, position_in_vehid_chain_from_end) {
	0: spriteset_pax_24twilight_gen;
    1: spriteset_pax_24twilight_7;
    2: spriteset_pax_24twilight_7;
    3: spriteset_pax_24twilight_6;
	switch_pax_24twilight_forward_autoform;
	}
	
